<resources>
    <string name="app_name">三指双击放大</string>
    <string name="tile_label">三指双击放大</string>
    <string name="accessibility_label">三指双击放大</string>
    <string name="accessibility_summary">三根手指轻点两下切换全屏放大，任意界面（含游戏）均可使用。</string>
    <string name="accessibility_description">开启后，系统会以只读方式监听原始触摸输入，识别「三指双击」并切换全屏放大：再次三指双击即取消。单指点击、长按、滑动及所有系统手势都原样传递，不会出现连点三次误触放大。本服务需要「触摸探索」能力用于手势通道、「放大」能力用于缩放屏幕，不读取界面内容、不联网、不收集数据。</string>

    <string name="title">三指双击放大</string>
    <string name="subtitle">iOS 风格缩放 · 系统级全局生效</string>
    <string name="status_title">运行状态</string>
    <string name="status_not_enabled">● 未开启无障碍服务</string>
